# === Telegram Bot Config ===
BOT_TOKEN=your_bot_token_here

# === Admin Config ===
# آیدی عددی تلگرام مدیرها (با کاما جدا کنید)
ADMIN_USER_IDS=123456789,987654321

# === Bot ===
# نام کاربری ربات بدون @ (اختیاری — خودکار خوانده می‌شود؛ برای لینک معرف لازم است)
BOT_USERNAME=your_bot_username

# === Server ===
WEBAPP_PORT=5000

# === Database (اختیاری) ===
DATABASE_PATH=database.json
UPLOAD_FOLDER=uploads
