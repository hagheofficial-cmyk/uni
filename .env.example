# === Telegram Bot Config ===
BOT_TOKEN=your_bot_token_here

# === Admin Config ===
# آیدی عددی تلگرام مدیرها (با کاما جدا کنید)
ADMIN_USER_IDS=123456789,987654321

# === Web App Config ===
# آدرس عمومی سرور (مثلاً https://your-app.onrender.com)
WEBAPP_URL=https://your-domain.com
WEBAPP_PORT=5000

# === Database ===
DATABASE_PATH=uni_project_bot.db
UPLOAD_FOLDER=uploads
