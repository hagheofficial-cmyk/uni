# ======== ضروری ========
BOT_TOKEN=123456789:ABC_your_bot_token_from_BotFather
ADMIN_USER_IDS=123456789,987654321
# نام کاربری ربات بدون @ (اختیاری - خودکار تشخیص داده می‌شود)
BOT_USERNAME=your_bot_username

# ======== هوش مصنوعی (لایه انتزاعی - یکی را پر کنید) ========
# گزینه 1: OpenAI
AI_PROVIDER=openai
AI_API_KEY=sk-xxxx
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# گزینه 2: Groq (رایگان سخاوتمندانه، فارسی خوب)
# AI_PROVIDER=groq
# AI_API_KEY=gsk_xxxx
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=https://api.groq.com/openai/v1

# گزینه 3: Gemini (Google) - سهمیه رایگان
# AI_PROVIDER=gemini
# AI_API_KEY=AIza...
# AI_MODEL=gemini-1.5-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# گزینه 4: OpenRouter (دسترسی به مدل‌های رایگان متعدد)
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-xxxx
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_BASE_URL=https://openrouter.ai/api/v1

# اگر خالی بماند، ربات بدون AI هم کار می‌کند (فقط فرم و FAQ ثابت)

# ======== Google Sheets ========
# مسیر فایل JSON حساب سرویس (Service Account)
GOOGLE_SERVICE_ACCOUNT_JSON=/home/user/uni/google-credentials.json
# یا محتوای JSON به صورت یک خطی (برای Render)
# GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT={"type":"service_account", ...}
GOOGLE_SHEET_ID=1a2b3c_your_sheet_id
# نام شیت‌ها (اختیاری - پیش‌فرض همانند مستندات)
# GOOGLE_SHEET_NAME=InsuranceBot

# ======== میزبانی ========
WEBAPP_PORT=10000
PORT=10000
DATABASE_PATH=data/app.db
UPLOAD_FOLDER=uploads
KNOWLEDGE_FOLDER=knowledge_docs

# ======== تنظیمات اختیاری ========
# شناسه کانال لاگ خطاها (اختیاری)
LOG_CHANNEL_ID=
# حالت دیباگ
DEBUG=false
# زبان پیش‌فرض (fa)
DEFAULT_LANGUAGE=fa
